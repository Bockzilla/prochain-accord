{
  "name": "prochain-accord",
  "version": "1.0.0",
  "private": true,
  "description": "PWA : détection d'accords de guitare, suggestions harmoniques et métronome. Tout tourne sur l'appareil.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.68.7"
  }
}
